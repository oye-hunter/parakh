{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "GROQ_API_KEY", "GROQ_MODEL", "NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {}
  }
}
