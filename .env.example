# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string. Console → your project → Connection Details.
# Use the *pooled* connection string.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/parakh?sslmode=require"

# ── AI ──────────────────────────────────────────────────────────────────────
# Groq API key — https://console.groq.com/keys
# SERVER ONLY. Never prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_.
GROQ_API_KEY="gsk_..."

# Model id. Verify against https://console.groq.com/docs/models before the demo —
# Groq rotates model availability. Must support tool use / JSON output.
GROQ_MODEL="llama-3.3-70b-versatile"

# ── Auth ────────────────────────────────────────────────────────────────────
# Signing secret for officer sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="generate-your-own-do-not-reuse-this"
BETTER_AUTH_URL="http://localhost:3000"

# ── Mobile ──────────────────────────────────────────────────────────────────
# Base URL of the Next.js API, reachable from the phone.
# Simulator: http://localhost:3000 · Android emulator: http://10.0.2.2:3000
# Physical device: http://<your-LAN-ip>:3000
EXPO_PUBLIC_API_URL="http://localhost:3000"
