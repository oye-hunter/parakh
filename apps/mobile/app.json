{
  "expo": {
    "name": "Parakh",
    "slug": "parakh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "parakh",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/parakh.png",
    "splash": {
      "image": "./assets/parakh.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffeb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.parakh.app"
    },
    "android": {
      "package": "pk.parakh.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/parakh.png",
        "backgroundColor": "#ffffeb"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/parakh.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "459dacca-8a7d-4dc7-a787-6dad3a8bbb76"
      }
    }
  }
}
